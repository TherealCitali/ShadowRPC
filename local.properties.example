# Copy to local.properties (git-ignored). Android Studio adds sdk.dir automatically.
# sdk.dir=/path/to/Android/Sdk

# Discord Application ID from https://discord.com/developers/applications.
# Create a NEW application for ShadowRPC (do not reuse another app's ID).
# Enable the Social SDK / presence for it and add this redirect URI:
#   discord-<APPLICATION_ID>:/authorize/callback
# Leave unset to use the official ShadowRPC application.
# DISCORD_APPLICATION_ID=1549707822390976593
