    <string name="icon_consent_title">Upload app icons publicly?</string>
    <string name="icon_consent_body">To show launcher icons in Discord, ShadowRPC uploads them anonymously to Catbox. The filename includes the Android package name. Catbox receives your IP address and hosts a public image URL; that URL is sent to Discord. ShadowRPC cannot automatically delete these anonymous uploads. Clearing the local cache does not delete remote files. You can use RPC without icons and turn this option off anytime.</string>
    <string name="icon_consent_allow">Allow public icon uploads</string>
    <string name="icon_consent_without">Continue without icons</string>
    <string name="build_information">Build information</string>
    <string name="qs_title">Quick Settings tile</string>
    <string name="qs_help">Open Android Quick Settings, tap Edit, and drag the ShadowRPC tile into your active tiles. It toggles master RPC without changing your selected apps. Unlock to toggle. Enable App Detection separately to publish foreground apps.</string>
    <string name="qs_sign_in">Sign in required</string>
    <string name="icon_upload_permission">Allow public app-icon uploads</string>
    <string name="icon_upload_permission_summary">Turning off revokes consent and hides icons. It cannot undo uploads already started, delete remote images, or clear saved links. Delete saved icon links in the storage settings to remove only the local cache.</string>
    <string name="pause_timing_note">Pausing preserves the master toggle and detection settings. Timers resume on a later detection poll, not an exact alarm; Android suspension or clock changes can delay resumption. Master Off still stops the watcher and notification.</string>
