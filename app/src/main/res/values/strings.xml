    <string name="settings_backup_summary">Back up selected apps, overrides, appearance and privacy preferences. Excludes Discord credentials/account data, logs, uploaded-icon URLs, upload consent, running toggles and pause timers. Backups can reveal your app list and custom text: review before sharing.</string>
    <string name="settings_import_confirm">Apply the settings in this file? Included preferences and selected apps will replace their current values. Your Discord session, master/detection toggles and icon-upload consent will not change. This can change an active presence. Unknown fields are ignored.</string>
